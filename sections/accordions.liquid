{{ 'accordion.css' | asset_url | stylesheet_tag }}
{{ 'accordion.js' | asset_url | script_tag }}

<div id="accordion-wrapper">
  <div class="accordion-box">
    <h2 class="accordion-section-title">{{ section.settings.title }}</h2>
    <div class="accordion-container">
      {% for block in section.blocks %}
        <div id="{{ block.settings.accordion_type }}" class="accordion-item" data-index="{{ forloop.index0 }}" data-type="{{ block.settings.accordion_type }}">
          <div class="accordion-title">
            <span class="accordion-title-text">{{ block.settings.accordion_title }}</span>
            <span class="accordion-icon">
              <!-- Plus Icon -->
              <svg
                class="icon-plus"
                xmlns="http://www.w3.org/2000/svg"
                width="27"
                height="27"
                viewBox="0 0 27 27"
                fill="none"
              >
                <path d="M13.5 5.90625V21.0938M21.0938 13.5H5.90625" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <!-- Minus Icon -->
              <svg
                class="icon-minus"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path d="M19.5 12H4.5" stroke="black" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
          <div class="accordion-answer-receive">
            {% if block.settings.accordion_type == 'text_topics' %}
              <div class="accordion-topics-with-text">
                {{ block.settings.accordion_answer }}
              </div>

            {% elsif block.settings.accordion_type == 'image_text' %}
              <div class="accordion-img-with-text">
                {% if block.settings.accordion_image != blank %}
                  <img
                    src="{{ block.settings.accordion_image | img_url: '400x' }}"
                    alt="{{ block.settings.accordion_title | escape }}"
                  >
                {% endif %}
                <div class="accordion-text">
                  {{ block.settings.accordion_answer }}
                </div>
              </div>
            {% elsif block.settings.accordion_type == 'size_chart' %}
              <div class="accordion-size-chart">
                <div class="prose">{{ section.settings.size_chart_page.content }}</div>
                <div class="accordion-text">
                  {{ block.settings.accordion_answer }}
                </div>
              </div>
            {% elsif block.settings.accordion_type == 'only_text' %}
              <div class="accordion-only-text">
                {{ block.settings.accordion_answer }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="accordion-container-desktop"></div>
  </div>
</div>

{% schema %}
{
  "name": "Accordion FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Accordion Title"
    },
    {
      "type": "page",
      "id": "size_chart_page",
      "label": "Size chart page"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "accordion_title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "accordion_answer",
          "label": "Answer"
        },
        {
          "type": "select",
          "id": "accordion_type",
          "label": "Accordion Type (Desktop only)",
          "default": "only_text",
          "options": [
            { "value": "only_text", "label": "Only Text" },
            { "value": "image_text", "label": "Image with Text" },
            { "value": "size_chart", "label": "Size chart type" },
            { "value": "text_topics", "label": "Text with topics" }
          ]
        },
        {
          "type": "image_picker",
          "id": "accordion_image",
          "label": "Image for (Image with Text Type)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Accordion FAQ",
      "category": "FAQ",
      "blocks": [{ "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
