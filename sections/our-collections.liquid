{{ 'our-collections.css' | asset_url | stylesheet_tag }}
{{ 'our-collections.js' | asset_url | script_tag }}

<div class="our-collections__container">
  <h2 class="our-collections__title">{{ section.settings.title }}</h2>
  <div class="our-collections__wrapper">
    <div class="our-collections__navigation">
      <button class="swiper-button-prev our-collections__nav-prev" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
          <path d="M12.2499 20.0139L14.3999 17.8239L7.1499 10.5239L14.3999 3.27393L12.2499 1.07392L4.9499 8.37393L2.7499 10.5239L4.9499 12.7239L12.2499 20.0239L12.2499 20.0139Z" fill="black"/>
        </svg>
      </button>
      <div class="swiper our-collections__swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {% assign collection = collections[block.settings.collection] %}
            {% if collection %}
              <div class="swiper-slide" data-block-index="{{ forloop.index0 }}">
                <a href="{{ collection.url }}" class="our-collections__item" {{ block.shopify_attributes }}>
                  <img
                    class="our-collections__item-thumb"
                    src="{% if block.settings.custom_image != blank %}{{ block.settings.custom_image | image_url }}{% else %}{{ collection.image | image_url }}{% endif %}"
                    alt="{% if block.settings.custom_title != blank %}{{ block.settings.custom_title }}{% else %}{{ collection.title }}{% endif %}"
                  >
                  <h3 class="our-collections__item-title">
                    {% if block.settings.custom_title != blank %}
                      {{ block.settings.custom_title }}
                    {% else %}
                      {{ collection.title }}
                    {% endif %}
                  </h3>
                  <span class="our-collections__item-cta">Explore Collection</span>
                </a>
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      </div>
      <button class="swiper-button-next our-collections__nav-next" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="20" height="21" focusable="false">
          <path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z" fill="black"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Our Collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Collection Title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Collection Image"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Our Collections",
      "category": "Custom",
      "blocks": [
        {
          "type": "collection_block"
        },
        {
          "type": "collection_block"
        },
        {
          "type": "collection_block"
        }
      ]
    }
  ]
}
{% endschema %}
