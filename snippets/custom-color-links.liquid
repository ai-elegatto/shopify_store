
{% if product.metafields.custom.product_color %}

  <div class="custom-colors-links">
      <div class="variant-picker__option-info h-stack justify-between gap-2">
        <div class="h-stack gap-1">
          <legend>{{ label }}</legend>
        </div>
      </div>
    <div class="variant-picker__option-values h-stack gap-2.5 wrap">
      {% for link in product.metafields.custom.product_color.value %}
          {%- assign color_swatch_parts = link | split: ':' -%}
          {%- assign color_swatch_name = color_swatch_parts.first | strip -%}
          {%- assign color_swatch_value = color_swatch_parts.last | strip -%}
        
        <a href="/products/{{ color_swatch_value }}" class="block-swatch {% if product.handle == color_swatch_value %}active{% endif %}">{{ color_swatch_name }}</a>
      {% endfor %}
    </div>
  </div>
{% endif %}

