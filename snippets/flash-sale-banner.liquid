{% comment %} 
  Flash Sale Banner - Final Mobile Optimized Version
{% endcomment %}
{% assign collection_handle = 'clearance-sale' %}
{% assign product_limit = 10 %}
{% assign reset_hours = 6 %}

<section class="fs-banner-section">
  <div class="fs-banner-container">
    
    <div class="fs-content-col">
      <div class="fs-info-stack">
        <h2 class="fs-title">FLASH SALE ⚡</h2>
        
        <div class="fs-timer-row">
          <span class="fs-ends-label">Ends In:</span>
          <div class="fs-timer-display">
            <span id="fs-hrs">00</span>:<span id="fs-min">00</span>:<span id="fs-sec">00</span>
          </div>
        </div>

        <p class="fs-subtitle">This week’s top deals are live—marked down and moving fast. New flash sales drop weekly. Shop before they’re gone.</p>

        <a href="/collections/{{ collection_handle }}" class="fs-action-btn desktop-only-btn">Shop All Deals</a>
      </div>
    </div>

    <div class="fs-slider-col">
      <div class="fs-products-track">
        {% for product in collections[collection_handle].products limit: product_limit %}
          <div class="fs-card">
            <a href="{{ product.url }}" style="text-decoration: none;">
              <div class="fs-img-holder">
                <img src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}" alt="{{ product.title }}">
                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price | money_without_trailing_zeros %}
                  <div class="fs-badge">⚡ {{ discount }} OFF</div>
                {% endif %}
              </div>
              <div class="fs-product-info">
                <h3 class="fs-product-title">{{ product.title }}</h3>
                <div class="fs-product-prices">
                  <span class="fs-price-now">{{ product.price | money }}</span>
                  <span class="fs-price-old">{{ product.compare_at_price | money }}</span>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <a href="/collections/{{ collection_handle }}" class="fs-action-btn mobile-only-btn">Shop All Deals</a>

  </div>
</section>

<style>
  /* БАЗОВЫЕ СТИЛИ (PC) */
  .fs-banner-section {
    padding: 0 !important;
    max-width: 100% !important;
    margin: 0 !important;
  }
  
  .fs-banner-container {
    background: #000;
    border-radius: 20px;
    padding: 60px 60px;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    align-items: center;
  }

  .fs-info-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .fs-title {
    font-size: 38px;
    font-weight: 900;
    color: #D4AF37;
    margin: 0 0 10px 0;
    letter-spacing: 1px;
  }

  .fs-timer-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    color: #fff;
  }
  .fs-ends-label {
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: #D4AF37;
  }
  .fs-timer-display {
    font-size: 24px;
    font-weight: 700;
    font-family: monospace;
    letter-spacing: 2px;
  }

  .fs-subtitle {
    font-size: 15px;
    line-height: 1.5;
    color: #bbb;
    margin: 0 0 35px 0;
    max-width: 320px;
  }

  .fs-action-btn {
    display: inline-block;
    padding: 15px 40px;
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 2px;
    border-radius: 0;
    transition: 0.3s;
    text-align: center;
  }
  .fs-action-btn:hover { background: #fff; color: #000; }

  /* Слайдер */
  .fs-slider-col { overflow: hidden; }
  .fs-products-track {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .fs-products-track::-webkit-scrollbar { display: none; }

  .fs-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    background: #fff;
    border-radius: 4px;
    padding-bottom: 15px;
  }
  .fs-img-holder { position: relative; aspect-ratio: 1; overflow: hidden; }
  .fs-img-holder img { width: 100%; height: 100%; object-fit: cover; }
  
  .fs-badge {
    position: absolute;
    top: 0; left: 0;
    background: #e00000;
    color: #fff;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 900;
    z-index: 2;
  }

  .fs-product-info { padding: 15px 15px 0 15px; text-align: left; }
  .fs-product-title {
    font-size: 13px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .fs-price-now { color: #000; font-weight: 800; font-size: 16px; margin-right: 8px; }
  .fs-price-old { color: #999; text-decoration: line-through; font-size: 14px; }

  /* Видимость кнопок */
  .mobile-only-btn { display: none !important; }

  /* =============================================
      МОБИЛЬНЫЕ НАСТРОЙКИ (768px и меньше)
     ============================================= */
  @media (max-width: 768px) {
    
    .fs-banner-section { padding: 0 !important; }

    .fs-banner-container {
      grid-template-columns: 1fr;
      padding: 20px 20px !important;
      border-radius: 12px;
      gap: 10px !important;
    }

    /* Управление кнопками */
    .desktop-only-btn { display: none !important; }
    .mobile-only-btn { 
      display: inline-block !important; 
      margin: 10px auto 0 auto !important; 
      width: auto !important; 
      padding: 10px 30px !important; 
      font-size: 12px !important;
    }

    .fs-title { font-size: 24px !important; margin-bottom: 8px !important; }
    .fs-timer-row { margin-bottom: 12px !important; gap: 8px !important; }
    .fs-subtitle { font-size: 13px !important; margin-bottom: 20px !important; line-height: 1.3 !important; max-width: 100% !important; }
    .fs-card { flex: 0 0 190px !important; }
    .fs-ends-label { font-size: 13px !important; }
    .fs-timer-display { font-size: 20px !important; }

    .fs-info-stack {
      align-items: flex-start !important;
      text-align: left !important;
    }
  }
</style>

<script>
  function runFlashTimer() {
    const hoursToReset = {{ reset_hours }};
    const now = new Date();
    const msInCycle = hoursToReset * 60 * 60 * 1000;
    const nextReset = Math.ceil(now.getTime() / msInCycle) * msInCycle;
    const diff = nextReset - now.getTime();

    const h = Math.floor(diff / (1000 * 60 * 60));
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((diff % (1000 * 60)) / 1000);

    const hDisplay = document.getElementById('fs-hrs');
    const mDisplay = document.getElementById('fs-min');
    const sDisplay = document.getElementById('fs-sec');

    if(hDisplay) hDisplay.innerText = h < 10 ? '0' + h : h;
    if(mDisplay) mDisplay.innerText = m < 10 ? '0' + m : m;
    if(sDisplay) sDisplay.innerText = s < 10 ? '0' + s : s;
  }
  setInterval(runFlashTimer, 1000);
  runFlashTimer();
</script>